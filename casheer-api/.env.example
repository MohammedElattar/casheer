# Casheer API environment — copy to .env and edit
NODE_ENV=development
PORT=3000

# Postgres
DATABASE_URL=postgres://casheer:casheer@localhost:5432/casheer

# JWT
JWT_ACCESS_SECRET=change_me_dev_secret_access_256bit
JWT_REFRESH_SECRET=change_me_dev_secret_refresh_256bit
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# CORS
WEB_ORIGIN=http://localhost:5173

# Puppeteer — cached Chromium path (set if you skip download)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
