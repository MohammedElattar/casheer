{
  "name": "casheer-api",
  "version": "0.1.0",
  "private": true,
  "description": "Casheer POS backend (Express + pg + JWT). Reverse-engineered from legacy Oracle Forms 6i Casheer. See ../casheer/docs for the recovered business rules.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "migrate": "node --env-file=.env src/db/migrate.js",
    "seed": "node --env-file=.env src/db/seed.js",
    "test": "node --env-file=.env --test --test-concurrency=1 --test-reporter=spec tests/*.test.js",
    "dev:all": "concurrently -k -n api,web -c cyan,magenta \"npm:dev\" \"npm:dev --prefix ../casheer-web\""
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "puppeteer": "^22.15.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0"
  }
}
